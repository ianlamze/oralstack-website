# Oralstack — environment variables
# Copy this to `.env.local` (gitignored) and fill in real values.
# Static export bakes NEXT_PUBLIC_* values at build time, so re-run `npm run build`
# after changing any of these.

# --- Cloudflare Web Analytics --------------------------------------------------
# Get this from: Cloudflare dashboard → Analytics & Logs → Web Analytics →
# Add a site → copy the token from the beacon snippet.
# Without this set, the analytics script is not injected at all.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# --- Cal.com booking embed -----------------------------------------------------
# Your cal.com username (the part after cal.com/ in your booking URL).
# Without this, /book-a-demo falls back to a mailto card.
NEXT_PUBLIC_CALCOM_USERNAME=

# Your event slug. Default: "demo". Set this to whatever you named your demo event
# in Cal.com (e.g. "30min", "oralstack-demo").
NEXT_PUBLIC_CALCOM_EVENT=demo

# --- Google Search Console verification (HTML tag fallback) -------------------
# Only needed if DNS-based verification doesn't work. Set this to the value of
# the `content` attribute in the meta tag Search Console provides. Leave empty
# if you used DNS verification (Path A in SEARCH_CONSOLE.md).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
