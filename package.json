{
  "name": "oralstack",
  "version": "0.1.0",
  "private": true,
  "description": "oralstack.com — marketing site for the oralstack dental clinic OS",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test:smoke": "playwright test",
    "test:smoke:update": "playwright test --update-snapshots",
    "check:content": "node scripts/check-content.mjs",
    "build:cf": "next build && rm -rf out/functions && cp -r functions out/functions",
    "deploy:manual": "npm run build:cf && wrangler pages deploy out --project-name=oralstack --commit-dirty=true",
    "deploy": "echo '\\nProduction deploys are GitHub-integrated. Push to main to deploy.' && echo 'For a one-off out-of-band deploy: npm run deploy:manual\\n' && exit 1",
    "deck:pdf": "bash scripts/generate-deck-pdf.sh",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "motion": "^12.0.0",
    "next": "^16.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@cloudflare/workers-types": "^4.20260426.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.59.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
